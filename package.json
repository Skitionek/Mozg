{
  "name": "mozg",
  "version": "0.1.0",
  "description": "A 'slow by design' cross-database query layer with a single GraphQL endpoint",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests scripts",
    "verify:sources": "node scripts/verify-sources.js",
    "docs:sources": "node scripts/sources-doc.js",
    "health": "node scripts/catalog-health.js"
  },
  "dependencies": {
    "@graphql-mesh/neo4j": "^0.110.3",
    "@graphql-mesh/odata": "^0.109.3",
    "@graphql-mesh/openapi": "^0.112.7",
    "@graphql-mesh/soap": "^0.110.3",
    "@graphql-mesh/store": "^0.107.3",
    "@graphql-mesh/thrift": "^0.109.3",
    "@graphql-mesh/utils": "^0.107.3",
    "arangojs": "^10.6.0",
    "fast-xml-parser": "^5.12.0",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.0.1",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "n3": "^2.13.12",
    "pg": "^8.23.1",
    "rdfxml-streaming-parser": "^3.3.0",
    "sqlite3": "6.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-tools/schema": "^11.0.8",
    "eslint": "^10.14.0",
    "marked": "^18.1.3"
  },
  "license": "MIT",
  "overrides": {
    "lodash": "^4.18.1",
    "thrift": "^0.25.0",
    "graphql-scalars": "^2.0.1"
  },
  "allowScripts": {
    "sqlite3": true
  }
}
