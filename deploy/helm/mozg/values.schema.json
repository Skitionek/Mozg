{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Mozg chart values",
  "type": "object",
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "scaleToZero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "cooldownSeconds": { "type": "integer", "minimum": 0 },
        "pollingIntervalSeconds": { "type": "integer", "minimum": 1 },
        "initialCooldownSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "number"] },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "entity": {
      "type": "object",
      "required": ["name", "columns"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "obo": {
          "type": "object",
          "description": "OBO key (Bioregistry prefix) of each identifier column",
          "additionalProperties": { "type": ["string", "array", "null"] }
        },
        "oboForm": {
          "type": "object",
          "description": "How a keyed column stores its values when not in the key's canonical form",
          "additionalProperties": { "enum": ["local", "curie"] }
        },
        "relations": { "type": "array", "items": { "type": "object" } }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": {
          "enum": ["postgres", "mysql", "neo4j", "arango", "elasticsearch", "sqlite3"],
          "description": "mysql runs MariaDB by default; sqlite3 is a file Mozg opens in-process"
        },
        "image": { "$ref": "#/definitions/image" },
        "database": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "username": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string" },
        "dump": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
            "format": {
              "enum": ["tar.gz", "tgz", "dump", "sql", "sql.gz", "ndjson", "ndjson.gz", "sqlite", "sqlite.gz"],
              "description": "postgres: tar.gz, dump, sql, sql.gz; mysql: sql, sql.gz, tar.gz; neo4j: dump; arango: tar.gz of an arangodump directory; elasticsearch: tar.gz (a snapshot repository or NDJSON files), ndjson, ndjson.gz; sqlite3: sqlite, sqlite.gz, tar.gz"
            },
            "restoreJobs": { "type": "integer", "minimum": 1 },
            "verifySQL": { "type": "string" },
            "migrate": { "type": "boolean" }
          }
        },
        "initSQL": { "type": "string", "description": "postgres, mysql, sqlite3: SQL run once, after any dump" },
        "initCypher": {
          "type": ["string", "array"],
          "items": { "type": "string" },
          "description": "neo4j: Cypher run once, after any dump; one statement per entry"
        },
        "initJS": { "type": "string", "description": "arango: JavaScript run once in arangosh, with db the database" },
        "initBulk": { "type": "string", "description": "elasticsearch: documents in _bulk NDJSON form, loaded once" },
        "storage": {
          "type": "object",
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|k|M|G|T|P)?$" },
            "storageClass": { "type": "string" },
            "accessModes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "startupTimeoutSeconds": { "type": "integer", "minimum": 10 },
        "scaleToZero": { "$ref": "#/definitions/scaleToZero" },
        "service": {
          "type": "object",
          "properties": {
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "annotations": { "type": "object" }
          }
        },
        "neo4j": {
          "type": "object",
          "properties": {
            "heapSize": { "type": "string" },
            "pageCacheSize": { "type": "string" },
            "config": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
          }
        },
        "mysql": {
          "type": "object",
          "properties": {
            "args": { "type": "array", "items": { "type": "string" }, "description": "Extra server arguments" }
          }
        },
        "elasticsearch": {
          "type": "object",
          "properties": {
            "heapSize": { "type": "string", "pattern": "^[0-9]+[kKmMgG]$" },
            "config": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number", "boolean"] },
              "description": "Extra settings, as environment variables"
            }
          }
        },
        "downloaderImage": { "type": "string" },
        "initResources": { "$ref": "#/definitions/resources" },
        "catalog": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "preset": { "type": "string" },
            "label": { "type": "string" },
            "description": { "type": "string" },
            "category": { "type": "string" },
            "entities": { "type": "array", "items": { "$ref": "#/definitions/entity" } }
          }
        },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    }
  },
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": { "$ref": "#/definitions/image" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "resources": { "$ref": "#/definitions/resources" },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "testResources": { "$ref": "#/definitions/resources" },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "scrapeFrom": { "type": "array" },
        "annotations": { "type": "boolean" },
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "mozg": {
      "type": "object",
      "properties": {
        "httpTimeoutMs": { "type": "integer", "minimum": 1 },
        "httpRetries": { "type": "integer", "minimum": 0 },
        "httpCacheTtlMs": { "type": "integer", "minimum": 0 },
        "soapOperations": { "type": "string" },
        "logLevel": { "enum": ["error", "warn", "info", "debug"] },
        "logFormat": { "enum": ["json", "text"] },
        "slowQueryMs": { "type": "integer", "minimum": 0 },
        "httpCacheMaxEntries": { "type": "integer", "minimum": 1 },
        "resultCache": {
          "type": "object",
          "properties": {
            "ttlMs": { "type": "integer", "minimum": 0 },
            "perSource": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "maxEntries": { "type": "integer", "minimum": 1 },
            "maxBytes": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "connectionCacheMax": { "type": "integer", "minimum": 1 },
        "connectionIdleMs": { "type": "integer", "minimum": 0 },
        "ontologyCacheMax": { "type": "integer", "minimum": 1 },
        "ontologyTtlMs": { "type": "integer", "minimum": 0 },
        "viewsMaxBytes": { "type": "integer", "minimum": 1 },
        "viewsDefaultLimit": { "type": "integer", "minimum": 1 },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "query"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
              "description": { "type": "string" },
              "query": { "type": "object", "required": ["from"] },
              "refresh": {
                "type": "object",
                "properties": {
                  "ttlMs": { "type": "integer", "minimum": 0 },
                  "everyMs": { "type": "integer", "minimum": 0 },
                  "onStart": { "type": "boolean" },
                  "staleWhileRevalidate": { "type": "boolean" },
                  "minIntervalMs": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              },
              "maxRows": { "type": "integer", "minimum": 1, "maximum": 1000000 }
            },
            "additionalProperties": false
          }
        },
        "ontologies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "format": { "enum": ["obo", "turtle", "rdfxml", "owlxml"] },
              "obo": { "type": "string" },
              "label": { "type": "string" },
              "maxBytes": { "type": "integer", "minimum": 1 },
              "timeoutMs": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "allowPrivateMirrors": { "type": "boolean" },
        "shutdownGraceMs": { "type": "integer", "minimum": 0 },
        "wakeTimeoutMs": { "type": "integer", "minimum": 0 },
        "demandWindowMs": { "type": "integer", "minimum": 0 },
        "extraSourcesConfigMaps": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "type": "array" }
      }
    },
    "databaseDefaults": { "$ref": "#/definitions/database" },
    "databases": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
      "additionalProperties": { "$ref": "#/definitions/database" }
    }
  }
}
